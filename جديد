<style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');
        
        :root { 
            --bg-primary: #030712; 
            --bg-card: rgba(15, 23, 42, 0.85); 
            --accent-primary: #6366f1; 
            --accent-secondary: #06b6d4;
