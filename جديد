.translation-toggle.active{background:linear-gradient(135deg,rgba(99,102,241,.22),rgba(6,182,212,.16));border-color:rgba(6,182,212,.65);color:#f8fafc;box-shadow:0 0 18px rgba(6,182,212,.12),inset 0 1px 0 rgba(255,255,255,.08)}
