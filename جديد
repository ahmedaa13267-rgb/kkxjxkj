            --text-muted: #94a3b8;
            --border-color: rgba(255, 255, 255, 0.1);
            --card-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.8);
        }
 
        body { 
            font-family: 'Cairo', sans-serif; 
            background: radial-gradient(circle at 50% -20%, #1e1b4b 0%, var(--bg-primary) 70%);
            color: var(--text-main); 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0; 
            padding: 15px; 
            box-sizing: border-box; 
            overflow-x: hidden;
        }
 
        .bg-glow {
            position: fixed;
            width: 300px;
            height: 300px;
            background: rgba(99, 102, 241, 0.15);
            filter: blur(80px);
            border-radius: 50px;
            z-index: -1;
            animation: moveGlow 10s ease-in-out infinite alternate;
        }
 
        @keyframes moveGlow {
            0% { transform: translateY(-50px) translateX(-50px); }
            100% { transform: translateY(100px) translateX(100px); }
        }
 
        .container { 
            background: var(--bg-card); 
            padding: 1.75rem; 
            border-radius: 1.75rem; 
            width: 100%; 
            max-width: 750px; 
            box-shadow: var(--card-shadow); 
            border: 1px solid var(--border-color);
            backdrop-filter: blur(20px);
            animation: scaleUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            box-sizing: border-box;
        }
 
        .container::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 4px;
            background: var(--accent-gradient);
        }
 
        @keyframes scaleUp {
            from { opacity: 0; transform: translateY(20px) scale(0.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
 
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
 
        .shake-effect { animation: shake 0.4s ease-in-out; }
        /* Feedback effects */
        @keyframes answerShake {
            0%,100% { transform: translateX(0); }
            15% { transform: translateX(-10px); }
            30% { transform: translateX(10px); }
            45% { transform: translateX(-8px); }
            60% { transform: translateX(8px); }
            75% { transform: translateX(-5px); }
            90% { transform: translateX(5px); }
        }
        .shake-option {
            animation: answerShake .65s ease-in-out;
            background: linear-gradient(100deg, rgba(239,68,68,.34), rgba(70,8,20,.78)) !important;
            border-color: #ff3b4d !important;
            color: #ffd1d5 !important;
            box-shadow: 0 0 14px rgba(239,68,68,.55), inset 0 0 18px rgba(239,68,68,.12) !important;
        }
 
        /* Wrong-answer burn + disintegration effect: the option stays in place */
        @keyframes burnFlash {
            0% { filter: brightness(1); }
            12% { filter: brightness(1.9) saturate(1.8); }
            35% { filter: brightness(1.25) saturate(1.5); }
            100% { filter: brightness(1); }
        }
        @keyframes emberPulse {
            0%,100% { opacity:.25; transform:scale(.85); }
            45% { opacity:1; transform:scale(1.12); }
        }
        @keyframes crackShake {
            0%,100% { clip-path:inset(0 0 0 0); }
            20% { clip-path:polygon(0 0,100% 0,100% 45%,72% 47%,100% 52%,100% 100%,0 100%,0 55%,27% 53%,0 48%); }
            42% { clip-path:polygon(0 0,100% 0,100% 42%,76% 49%,100% 56%,100% 100%,0 100%,0 58%,24% 51%,0 44%); }
            68% { clip-path:polygon(0 0,100% 0,100% 100%,0 100%); }
        }
        @keyframes emberFly {
            0% { opacity:1; transform:translate(0,0) scale(1); }
            100% { opacity:0; transform:translate(var(--dx),var(--dy)) scale(.15) rotate(180deg); }
        }
        .wrong-answer.shake-option {
            position:relative;
            overflow:visible !important;
            animation: answerShake .65s ease-in-out, burnFlash .75s ease-out;
        }
        .wrong-answer.shake-option::before {
            content:'';
            position:absolute; inset:-3px; border-radius:inherit; pointer-events:none;
            background:repeating-linear-gradient(100deg, transparent 0 16px, rgba(255,183,0,.9) 18px 21px, transparent 23px 31px);
            mix-blend-mode:screen; opacity:0;
            animation: emberPulse .7s ease-out;
        }
        .wrong-answer.shake-option::after {
            content:'🔥  ✦  🔥';
            position:absolute; left:50%; top:-18px; transform:translateX(-50%);
            font-size:20px; letter-spacing:10px; white-space:nowrap; pointer-events:none;
            filter:drop-shadow(0 0 7px #ff6a00); opacity:0;
            animation: flameRise .8s ease-out forwards;
        }
        @keyframes flameRise {
            0% { opacity:0; transform:translate(-50%,10px) scale(.75); }
            25% { opacity:1; }
            100% { opacity:0; transform:translate(-50%,-30px) scale(1.2); }
        }
        .wrong-burn-particles { position:absolute; inset:0; pointer-events:none; overflow:visible; z-index:20; }
        .wrong-burn-particles i {
            position:absolute; width:6px; height:6px; border-radius:50%;
            background:radial-gradient(circle,#fff 0 18%,#ffd000 20% 48%,#ff4d00 52% 100%);
            box-shadow:0 0 8px #ff6a00,0 0 14px rgba(255,80,0,.7);
            animation:emberFly .75s ease-out forwards;
        }
        .wrong-burn-particles .tear-line {
            position:absolute; top:8%; bottom:8%; width:3px;
            background:linear-gradient(180deg,transparent,#fff,#ff3b00,transparent);
            filter:drop-shadow(0 0 6px #ff3b00); opacity:0;
            animation:tearFlash .65s ease-out forwards;
        }
        @keyframes tearFlash {
            0%,100% { opacity:0; transform:scaleY(.3); }
            20%,65% { opacity:1; transform:scaleY(1); }
        }
        .correct-answer {
