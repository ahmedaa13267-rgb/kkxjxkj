        .score-badge { background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(6, 182, 212, 0.12)); border: 1px solid rgba(99, 102, 241, 0.25); padding: 1.25rem; border-radius: 1.25rem; text-align: center; margin-bottom: 1.25rem; }
