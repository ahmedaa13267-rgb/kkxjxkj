            background: var(--bg-card); 
            padding: 1.75rem; 
            border-radius: 1.75rem; 
            width: 100%; 
            max-width: 750px; 
            box-shadow: var(--card-shadow); 
            border: 1px solid var(--border-color);
            backdrop-filter: blur(20px);
            animation: scaleUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            box-sizing: border-box;
        }

